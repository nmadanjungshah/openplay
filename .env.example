# Copy to .env.local and fill in. These two values are public by design;
# security comes from Row Level Security in the database.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Base URL used in shared invite links (your Vercel domain in production).
EXPO_PUBLIC_APP_URL=http://localhost:8081
